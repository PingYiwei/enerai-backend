# Application
ENERAI_APP_NAME=EnerAI API
ENERAI_ENV=development
ENERAI_API_PREFIX=/api/v1

# MongoDB
ENERAI_MONGODB_USERNAME=replace-with-mongodb-username
ENERAI_MONGODB_PASSWORD=replace-with-mongodb-password
ENERAI_MONGODB_URI=mongodb://username:password@localhost:27017/
ENERAI_MONGODB_DATABASE=enerai

# Authentication and encrypted user Provider credentials
ENERAI_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ENERAI_JWT_ALGORITHM=HS256
ENERAI_ACCESS_TOKEN_MINUTES=480
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENERAI_PROVIDER_SECRET_KEY=replace-with-a-fernet-key

# Web and Agent runtime
ENERAI_CORS_ORIGINS=["http://localhost:5173"]
ENERAI_AGENT_CONTEXT_CHAR_BUDGET=300000
ENERAI_DEFAULT_PROVIDER=bailian

# Provider endpoints. API keys, API modes, and models are saved per user.
ENERAI_OPENAI_BASE_URL=https://api.openai.com/v1
ENERAI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ENERAI_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
